<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    android:fillViewport="true">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">


        <!-- Card container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="790dp"
                android:orientation="vertical"
                android:padding="25dp">

                <!-- Logo badge -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_logo_badge">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_logo"
                        android:src="@drawable/ic_user" />
                </FrameLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="@string/register_title"
                    android:textColor="@color/gray_900"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="@string/register_subtitle"
                    android:textColor="@color/text_hint"
                    android:textStyle="normal"
                    android:textSize="13sp" />


                <!-- Full name -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/etFullName"
                    android:text="@string/register_label_full_name"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFullName"
                    style="@style/FieldInput"
                    android:layout_marginTop="6dp"
                    android:autofillHints="name"
                    android:hint="@string/register_hint_full_name"
                    android:inputType="textPersonName" />

                <!-- Email -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@+id/etEmail"
                    android:text="@string/register_label_email"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/FieldInput"
                    android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/register_hint_email"
                    android:inputType="textEmailAddress" />

                <!-- Password -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@+id/etPassword"
                    android:text="@string/register_label_password"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etPassword"
                        style="@style/FieldInput"
                        android:autofillHints="password"
                        android:hint="@string/register_hint_password"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="35dp" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="30dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:clickable="true"
                        android:contentDescription="@string/toggle_password_visibility"
                        android:focusable="true"
                        android:src="@drawable/ic_padlock" />
                </FrameLayout>

                <!-- Confirm password -->

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@+id/etConfirmPassword"
                    android:text="@string/register_label_confirm_password"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/FieldInput"
                    android:layout_marginTop="6dp"
                    android:autofillHints="password"
                    android:hint="@string/register_hint_confirm_password"
                    android:inputType="textPassword" />

                <!-- Create account button -->
                <Button
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_hover"
                    android:elevation="0dp"
                    android:maxWidth="320dp"
                    android:stateListAnimator="@null"
                    android:text="@string/register_btn_create"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Divider: or continue with -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/gray_900" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/register_divider_or"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/gray_900" />
                </LinearLayout>

                <!-- Social buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">


                    <LinearLayout
                        android:id="@+id/btnGoogle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_social_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/google_icon"
                            android:src="@drawable/ic_google" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/google_label_icon"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnApple"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_social_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/apple_icon"
                            android:src="@drawable/ic_apple" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/apple_label_icon"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Footer link -->
                <TextView
                    android:id="@+id/tvAlreadyHaveAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:text="@string/register_footer_login_prompt"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>